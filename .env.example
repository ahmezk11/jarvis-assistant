# Copy this file to .env and fill in any keys you want to enable.
# Missing keys simply disable that feature — the app won't crash.

# Anthropic — https://console.anthropic.com (enables the "Claude (cloud)" brain)
ANTHROPIC_API_KEY=

# Tavily Search — https://tavily.com (free tier: 1,000 searches/month)
TAVILY_API_KEY=

# NewsAPI — https://newsapi.org (free tier: 100 req/day)
NEWS_API_KEY=

# Notion — https://www.notion.so/my-integrations (internal integration token).
# Share the pages/databases you want Jarvis to reach with the integration.
NOTION_TOKEN=

# Google (Gmail + Calendar + Drive) — absolute path to the OAuth client-secrets
# JSON downloaded from Google Cloud Console (Desktop app credentials). First use
# opens a browser for consent; a refresh token is then cached in token.json.
GOOGLE_CALENDAR_CREDENTIALS=

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys (free tier ~10k chars/month).
# Gives EDITH a real voice; without it she falls back to the browser's built-in voice.
ELEVENLABS_API_KEY=
# Optional overrides:
# ELEVENLABS_VOICE_ID=jv41DhCf464zw0TI7I1w
# ELEVENLABS_MODEL=eleven_flash_v2_5
